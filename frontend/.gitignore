
# ============================================================
# AVERRA STAFFING SOLUTIONS LTD
# Git ignore rules
# ============================================================

# Python virtual environments
.venv/
venv/
env/

# Python cache files
__pycache__/
*.py[cod]
*$py.class

# Environment variables and secrets
.env
.env.*
!.env.example

# Local databases and database backups
*.db
*.sqlite
*.sqlite3
*.db-journal
*.sqlite-wal
*.sqlite-shm
*.bak
*.backup
*.dump

# Logs
*.log
logs/
backend/logs/

# Operating system files
.DS_Store
Thumbs.db
desktop.ini
ehthumbs.db

# IDE and editor settings
.idea/
.vscode/
*.iml

# Temporary files
*.tmp
*.temp
*.swp
*.swo
*~

# Build and test output
dist/
build/
coverage/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.pyright/
htmlcov/
*.egg-info/

# Node.js dependencies
node_modules/

# Private files and candidate uploads
private/
uploads/
backend/uploads/
frontend/uploads/

# Ignore candidate CVs and private application documents
# in designated upload directories only
backend/uploads/**/*.pdf
backend/uploads/**/*.doc
backend/uploads/**/*.docx
uploads/**/*.pdf
uploads/**/*.doc
uploads/**/*.docx

# Python test and coverage files
.coverage
coverage.xml
nosetests.xml
junit.xml

# Local environment and application data
.streamlit/secrets.toml
instance/
*.pid
.cache/

# Python environment configuration
# Keep .python-version tracked if used for deployment

# ============================================================
# IMPORTANT:
# Do not globally ignore *.pdf, *.doc, *.docx or *.sql.
# Legitimate business documents and SQL migrations may belong
# in Git. Keep confidential documents out of the repository.
# ============================================================
