
# ============================================================
# AVERRA STAFFING SOLUTIONS LTD
# Environment variable template
# Copy this file to .env and configure local values.
# Never put real secrets in this file.
# ============================================================

# Application
APP_NAME=AVERRA Staffing Solutions API
APP_VERSION=1.0.0
APP_ENV=development
DEBUG=false

# Server
HOST=127.0.0.1
PORT=8000

# Database
DATABASE_URL=sqlite:///./database/averra.db
DATABASE_PATH=./database/averra.db

# Frontend origins allowed to access the API
CORS_ORIGINS=http://localhost:5500,http://127.0.0.1:5500,https://averrastaffing.co.uk,https://www.averrastaffing.co.uk

# Logging
LOG_LEVEL=INFO

# File uploads
UPLOAD_DIR=./uploads
MAX_UPLOAD_SIZE_MB=5
ALLOWED_UPLOAD_EXTENSIONS=.pdf,.docx

# Security
# Set a unique, randomly generated value in your local .env file.
SECRET_KEY=mN1OOERNcEfXoR0qssi-TU1MzgnNy37HYqUzxhciF0pm0Hg8S29_MlOlAvBrGqQT


# Authentication
ACCESS_TOKEN_EXPIRE_MINUTES=30

# Company information
COMPANY_NAME=AVERRA Staffing Solutions Ltd
COMPANY_EMAIL=info@averrastaffing.co.uk
COMPANY_WEBSITE=https://averrastaffing.co.uk
